   "source": [
    "### Tuples\n",
    "- are IMMUTABLE\n",
    "- used with Normal Parenthesis\n",
    "- we CANNOT change/modify the values inside tuples, but can add the tuple with another tuple\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "22c405fe",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "(1, 2, 3, 'a', 'b', 'c')"
      ]
     },
     "execution_count": 2,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "#### Tuple\n",
    "\n",
    "tup1 = (1,2,3)\n",
    "tup1\n",
    "\n",
    "tup2 = ('a','b','c')\n",
    "tup3 = tup1 + tup2\n",
    "\n",
    "tup3\n",
    "\n"
   ]
  }
